{
  "name": "eventbox-uz",
  "version": "1.0.0",
  "private": true,
  "description": "EventBox UZ — O'zbekistondagi tadbir jihozlari va xizmatlari marketpleysi",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n API,WEB -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "seed": "node server/seed.js",
